# Environments and caches
.venv/
__pycache__/
*.pyc
.ruff_cache/

# Recordings. The one in example/ is deliberately kept - it is the input the
# worked example runs on, and without it the example cannot be followed.
*.mjpeg
*.mp4
*.gif
!example/example.mp4

# Extracted frames. The folder is named after the video, so there is no generic
# pattern to match - only the one the worked example produces needs ignoring.
# Generated and exactly reproducible from the video beside it: example.mp4 is
# 896 KB, its 277 frames are 27 MB as PNG.
example/example/
captures/
out/
