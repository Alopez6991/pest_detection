# Environments and caches
.venv/
__pycache__/
*.pyc
.ruff_cache/

# Recordings. The one in example/ is deliberately kept - it is the input the
# worked example runs on, and without it the example cannot be followed.
*.mjpeg
*.mp4
*.gif
!example/example.mp4

# Extracted frames. Generated by example/video_to_frames.py and exactly
# reproducible from the video beside them, so there is nothing to version:
# example.mp4 is 896 KB, its frames are 2.2 MB across 277 files.
*_frames/
captures/
out/
